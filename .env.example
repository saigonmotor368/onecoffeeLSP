NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push: generate one key pair with `npx web-push generate-vapid-keys`.
# Keep the private key secret; use the same pair in local and Vercel production.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@onecoffee.vn

# VietQR Payment Configuration
# Supported bank IDs: MB, VCB, TCB, VPB, ACB, BIDV, etc.
NEXT_PUBLIC_BANK_ID=MB
NEXT_PUBLIC_BANK_ACCOUNT=0977999948
NEXT_PUBLIC_ACCOUNT_NAME=PHAM XUAN DINH

# App URL (set to your Vercel domain in production)
NEXT_PUBLIC_APP_URL=https://one-coffee-lsp.vercel.app
